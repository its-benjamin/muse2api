# ==========================================
# Copy to .env to take effect (Linux/macOS: cp .env.example .env; Windows: copy .env.example .env,
# or just double-click start-windows.bat which does it automatically).
# ==========================================

# [required/optional] Admin & API auth key (starts with m2a_).
# Leave empty to automatically generate a fresh secure key on first launch (printed in the console).
MUSE2API_KEY=

# Listen address and port (use 0.0.0.0 inside Docker containers)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Public base URL (used by downstream clients and by the admin page when building links, e.g. https://api.yourdomain.com)
# When empty, the admin page automatically uses the host and port the browser is currently visiting
MUSE2API_PUBLIC_BASE=

# Chromium executable path (auto-detected when empty).
# Linux/Docker examples: /usr/bin/chromium or /usr/bin/chromium-browser
# Local Windows run: leave empty (Chrome / Edge are found automatically), or fill in the full path e.g. C:\Program Files\Google\Chrome\Application\chrome.exe
MUSE2API_CHROMIUM=

# CDP remote-debugging port
MUSE2API_CDP_PORT=19210

# Task timeouts (in seconds)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Browser idle shutdown (minutes of no generations before the headless browser
# is stopped to free ~200-400MB RAM; 0 = never, stays warm for fastest response).
# Low-RAM local machines: set 10-15. Next request relaunches it automatically.
MUSE2API_BROWSER_IDLE_MIN=0

# Experimental HTTP/2 (0 = HTTP/1.1 only). Set 1 to serve H1+H2 on the same port
# (needs `pip install zttp`, installed by default via requirements.txt).
# Note: browsers only use H2 over TLS, so browser-facing H2 needs a TLS reverse
# proxy in front; direct H2 here benefits h2c-capable API clients.
MUSE2API_HTTP2=0
